---
import { withBase } from "../lib/paths";
import { categories, type Tool } from '../data/tools';
interface Props { tool: Tool; }
const { tool } = Astro.props;
---
<article class="tool-card" data-tool data-search={[tool.name, tool.description, ...tool.tags].join(' ').toLowerCase()} data-category={tool.category}>
  <div class="card-top"><span class="tool-icon" aria-hidden="true">{tool.name.slice(0, 1)}</span><a class="category" href={withBase(`/categories/${tool.category}/`)}>{categories.find(c => c.slug === tool.category)?.name}</a></div>
  <h3><a href={withBase(`/tools/${tool.slug}/`)}>{tool.name}<span aria-hidden="true">↗</span></a></h3>
  <p>{tool.description}</p>
  <div class="tags">{tool.tags.map(tag => <span>{tag}</span>)}</div>
</article>
