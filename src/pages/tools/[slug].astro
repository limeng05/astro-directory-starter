---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools, categories } from '../../data/tools';
export function getStaticPaths() { return tools.map(tool => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const category = categories.find(c => c.slug === tool.category)!;
const related = tools.filter(t => t.category === tool.category && t.slug !== tool.slug).slice(0, 3);
const structured = { '@context': 'https://schema.org', '@type': 'WebPage', name: tool.name, description: tool.description, url: new URL(Astro.url.pathname, Astro.site).href, about: { '@type': 'WebSite', name: tool.name, url: tool.url } };
---
<Layout title={tool.name} description={tool.description}>
<script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\u003c')} />
<section class="detail"><a href="/">← All resources</a><p class="eyebrow"><a href={`/categories/${category.slug}/`}>{category.name}</a></p><h1>{tool.name}</h1><p class="intro">{tool.description}</p><div class="tags">{tool.tags.map(tag => <span>{tag}</span>)}</div><h2>Why explore it?</h2><p>{tool.body}</p><a class="button" href={tool.url}>Visit {tool.name} ↗</a><p class="fine">External website · Check the provider’s site for current features and terms.</p></section>
{related.length > 0 && <section><div class="section-heading"><h2>More to discover</h2><a href={`/categories/${category.slug}/`}>View category →</a></div><div class="grid">{related.map(t => <ToolCard tool={t} />)}</div></section>}
</Layout>
